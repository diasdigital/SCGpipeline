# Variables starting with VITE_ are read by the frontend (and bundled into the
# browser client code — do not put secrets here). Other variables are only
# read by the Python backend or Vite config-time (Node), never reaching the
# browser.
#
# Once the server is running, some LLM & evaluation configurations can be modified
# directly from the dashboard (PUT /api/dashboard/config) WITHOUT restarting the server.


# Example for local MySQL (e.g., via Laragon/XAMPP), adjust user/password accordingly.
DATABASE_URL=mysql+pymysql://root:@localhost:3306/scgpipeline

SECRET_KEY=replace-with-your-own-random-string


# ─── LLM PROVIDER ────────────────────────────────────────────────────────────
#
# LLM_PROVIDER determines the model backend being used.
# Options:
#   "ollama"     → Local LLM via Ollama (no API key required)
#   "openai"     → OpenAI GPT series (requires LLM_API_KEY)
#   "gemini"     → Google Gemini (requires LLM_API_KEY)
#   "fireworks"  → Fireworks AI (requires LLM_API_KEY)
#   "none"       → No model — FastAPI continues to run, responses are placeholders.
#                  Useful for development/testing without a GPU.
#
LLM_PROVIDER=ollama
LLM_MODEL=llama3
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434



NUM_SAMPLES=5
TEMPERATURE_SAMPLE=1.0
EVAL_METHOD=nli
THRESHOLD_HIGH=0.60
THRESHOLD_MID=0.40


# ─── REDIS ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379


# ─── MLFLOW ──────────────────────────────────────────────────────────────────
# Use cross-OS relative paths, e.g., file:./mlruns
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT=SelfCheckNLI_Evaluation


# ─── LANGSMITH (optional, for tracing) ───────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=research-hallucination-detection


# ─── HUGGING FACE ────────────────────────────────────────────────────────────
# Leave empty to use the default cache (~/.cache/huggingface)
HF_HOME=


# ─── CORS (BACKEND) ──────────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to access the API.
# Secure default for local development. If using a tunnel (cloudflared/ngrok) to
# expose externally, add your tunnel domain here.
#   example: CORS_ORIGINS=http://localhost:5174,https://xxxx.trycloudflare.com
CORS_ORIGINS=http://localhost:5174


# ─── FRONTEND (VITE) ─────────────────────────────────────────────────────────
#
# VITE_API_BASE_URL — leave empty for local development (axios uses relative path
# /api/..., forwarded by Vite proxy to BACKEND_URL below, with no CORS issues).
# Fill in if the backend is on another host/port or for a production build.
#   example: VITE_API_BASE_URL=https://api-xxxx.trycloudflare.com
VITE_API_BASE_URL=

# BACKEND_URL — Vite proxy target during development (not used by client code).
BACKEND_URL=http://127.0.0.1:8000

# VITE_ALLOWED_HOSTS — additional hostnames allowed to access the Vite dev server,
# comma-separated. Leave empty for localhost access only. Fill in if exposing
# the dev server via a tunnel, example: VITE_ALLOWED_HOSTS=xxxx.trycloudflare.com
VITE_ALLOWED_HOSTS=

# ─── DOCKER (optional) ───────────────────────────────────────────────────────
# Only used by docker-compose.yml. All have sensible defaults if left empty
# — see comments in docker-compose.yml.
# DATABASE_URL, REDIS_HOST, and MLFLOW_TRACKING_URI above are AUTOMATICALLY overridden
# by docker-compose.yml with Docker service names (mysql/redis/mlflow),
# so they do not need to be manually modified for Docker mode.
#
# MYSQL_DATABASE=
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_ROOT_PASSWORD=
# BACKEND_PORT=8000
# FRONTEND_PORT=8080
# MLFLOW_PORT=5000
# MYSQL_PORT=3306
# REDIS_PORT=6379